# Grafana Cloud MCP
GRAFANA_URL=https://<stack>.grafana.net
GRAFANA_MCP_ENDPOINT=https://mcp.grafana.com/mcp
GRAFANA_SERVICE_ACCOUNT_TOKEN=

# Google ADK / Gemini
GOOGLE_CLOUD_PROJECT=
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Persistence (SQLite by default; use Postgres in prod, e.g.
# postgresql+asyncpg://user:pass@host:5432/premiere_control_room)
DATABASE_URL=sqlite+aiosqlite:///./premiere_control_room.db

# Demo / ops
DEMO_MODE=true
CORS_ORIGINS=*

# Sentinel background polling loop (only runs once GOOGLE_API_KEY + GRAFANA_URL
# are set above; ignored in mock mode -- use /api/simulate/inject-anomaly there)
SENTINEL_POLL_INTERVAL_SECONDS=15
SENTINEL_SLO_THRESHOLDS_JSON=

# Synthetic live streaming pipeline (real OpenTelemetry metrics/logs/traces;
# see app/simulate/otel_pipeline.py). Console export by default -- set
# OTEL_EXPORTER_OTLP_ENDPOINT (a standard OTel env var) to point it at
# Grafana Cloud's OTLP gateway or a local collector instead.
SIMULATE_LIVE_PIPELINE=true
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=

# Leave GOOGLE_API_KEY / GRAFANA_URL unset to run the backend against the
# deterministic mock crew (app/adk_agents/mock_crew.py) instead of live
# Gemini + Grafana MCP -- useful for local development and UI work.
