# Grafana Cloud MCP
GRAFANA_URL=https://<stack>.grafana.net
GRAFANA_MCP_ENDPOINT=https://mcp.grafana.com/mcp
GRAFANA_SERVICE_ACCOUNT_TOKEN=

# Google ADK / Gemini -- two auth paths, pick one:
#   1. Vertex AI (used on Cloud Run -- see infra/scripts/00-setup.sh, which
#      grants the backend's service account Vertex AI access, so no key is
#      needed there). Locally, run `gcloud auth application-default login`
#      first, then set:
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=false
#   2. Gemini Developer API key instead (simpler for local dev):
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Persistence (SQLite by default; use Postgres in prod, e.g.
# postgresql+asyncpg://user:pass@host:5432/premiere_control_room)
DATABASE_URL=sqlite+aiosqlite:///./premiere_control_room.db

# Demo / ops
DEMO_MODE=true
CORS_ORIGINS=*

# Sentinel background polling loop (only runs once Gemini + GRAFANA_URL are
# configured above; ignored in mock mode -- use /api/simulate/inject-anomaly there)
SENTINEL_POLL_INTERVAL_SECONDS=15
SENTINEL_SLO_THRESHOLDS_JSON=

# Synthetic live streaming pipeline (real OpenTelemetry metrics/logs/traces;
# see app/simulate/otel_pipeline.py). Console export by default -- set
# OTEL_EXPORTER_OTLP_ENDPOINT (a standard OTel env var) to point it at
# Grafana Cloud's OTLP gateway or a local collector instead.
SIMULATE_LIVE_PIPELINE=true
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=

# Leave Gemini auth (both paths above) / GRAFANA_URL unset to run the backend
# against the deterministic mock crew (app/adk_agents/mock_crew.py) instead of
# live Gemini + Grafana MCP -- useful for local development and UI work.

# Auth (see docs/security.md). Leave JWT_SECRET unset for local dev -- a
# random one is generated per process start. Leave ADMIN_PASSWORD unset and
# a random one is generated + logged once on first startup.
JWT_SECRET=
JWT_EXPIRY_MINUTES=480
ADMIN_EMAIL=admin@premiere.local
ADMIN_PASSWORD=

# Notifications (see docs/agents.md#escalation--notifications). Comma-separated
# webhook URLs -- Slack incoming webhooks work directly, no separate integration.
NOTIFICATION_WEBHOOK_URLS=
ESCALATION_TIMEOUT_SECONDS=300
